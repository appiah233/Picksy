// Prisma schema file for Picksy
// Target Database: Neon PostgreSQL (Serverless)
// Note: Phase 1 establishes the schema blueprint; active database connections are out of scope.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// Importer Drafts Persistence (Neon PostgreSQL)
model ImportDraft {
  id                String   @id @default(uuid())
  sourceId          String
  canonicalUrl      String
  externalProductId String?
  state             String   @default("draft") // "draft" | "published"
  candidate         Json     // Serialized ProductImportCandidate
  edits             Json     // Serialized Partial<ProductImportCandidate>
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sourceId, canonicalUrl])
  @@index([sourceId, externalProductId])
  @@index([state])
}
