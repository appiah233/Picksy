# Application Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Picksy"

# Database Configuration (Future Neon PostgreSQL via Prisma)
# NOTE: Active database connection is out-of-scope for Phase 1.
DATABASE_URL="postgresql://user:password@ep-placeholder.us-east-2.aws.neon.tech/picksy?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-placeholder.us-east-2.aws.neon.tech/picksy?sslmode=require"

# Analytics & Integrations (Placeholders for Future Phases)
# NEXT_PUBLIC_ANALYTICS_ID=""

# Administrator authentication (Auth.js + GitLab OAuth)
# Set these as server-side deployment secrets; never use NEXT_PUBLIC_ for them.
AUTH_SECRET=""
AUTH_GITLAB_ID=""
AUTH_GITLAB_SECRET=""
# Comma-separated GitLab numeric user IDs allowed to administer Picksy.
AUTH_ADMIN_GITLAB_IDS=""
# Production GitLab OAuth callback: https://<picksy-origin>/api/auth/callback/gitlab
