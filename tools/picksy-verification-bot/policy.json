        "src/server/**",
        "src/app/studio/**",
        "prisma/**",
        ".github/workflows/**",
        ".github/scripts/**",
        "tools/**",
        "tests/**",
        "docs/**",
        "package.json",
        "package-lock.json",
        "next.config.ts",
        "tsconfig.json",
        "eslint.config.mjs"
      ],
      "prohibitedAreas": [
        "src/app/(storefront)/**",
        "src/components/ui/**",
        "src/features/catalog/**"
      ]
    },
    "Gemini": {
      "name": "Gemini",
      "role": "Lead Coordinator, Design, and Frontend Owner",
      "allowedAreas": [
        "src/app/(storefront)/**",
        "src/app/page.tsx",
        "src/app/layout.tsx",
        "src/app/globals.css",
