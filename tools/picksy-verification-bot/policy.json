      "mandatory": true,
      "description": "Lint, Typecheck, 193 unit/integration tests, and production build isolation"
    },
    "CodeQL JavaScript/TypeScript": {
      "mandatory": true,
      "description": "CodeQL static application security analysis"
    },
    "Production dependency audit": {
      "mandatory": true,
      "description": "Fail-closed production dependency audit with approved time-bound exceptions"
    },
    "public-baseline": {
      "mandatory": true,
      "description": "ZAP public baseline DAST scan"
    }
  },
  "protectedBranches": [
    "main"
  ],
  "agents": {
    "Codex": {
      "name": "Codex",
