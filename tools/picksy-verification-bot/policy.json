        "src/app/products/**",
        "src/components/**",
        "src/features/**",
        "src/config/**",
        "src/styles/**",
        "public/**",
        "docs/**",
        "package.json",
        "package-lock.json"
      ],
      "prohibitedAreas": [
        "prisma/schema.prisma",
        "src/lib/importer/pipeline.ts",
        ".github/workflows/security-sast.yml"
      ]
    }
  },
