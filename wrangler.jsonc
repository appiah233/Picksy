{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "picksy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "previews": {},
  "observability": {
    "enabled": true
  }
}
